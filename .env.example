# App Configuration
APP_PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todolist_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# JWT Authentication
JWT_SECRET=todolist_secret_jwt_key_2026_super_secure_random_string
JWT_EXPIRE_HOURS=72

# Swagger UI / Base URL Configuration
SWAGGER_HOST=mdt-solution.site
SWAGGER_BASE_PATH=/todo-list
SWAGGER_SCHEMES=https,http

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
